#!/usr/bin/env bash
# bob-fixme — bouton panique : revient à la version précédente des paquets
# touchés par la dernière transaction pacman, en réinstallant les vieux
# paquets encore présents dans /var/cache/pacman/pkg.
#
# L'ancien script snapper ne démarrait jamais (pas de snapper, racine ext4) et
# sa branche de secours n'installait rien : elle affichait « fait. » (audit
# BOB-03). Ici c'est un vrai rollback.
set -euo pipefail

BOBOS_LIB="${BOBOS_LIB:-/usr/local/lib/bobos/common.sh}"
# shellcheck source=/dev/null
[[ -r "$BOBOS_LIB" ]] && source "$BOBOS_LIB"

cat <<'ASCII'
  ____  _____ _____ _   _  ____ ____
 |  _ \|  ___|_   _| | | |/ ___|  _ \
 | | | | |_    | | | | | | |   | |_) |
 | |_| |  _|   | | | |_| | |___|  _ <
 |____/|_|     |_|  \___/ \____|_| \_\
ASCII
echo

require_root "$@"

PACMAN_LOG="${BOBOS_PACMAN_LOG:-/var/log/pacman.log}"
CACHE="${BOBOS_PACMAN_CACHE:-/var/cache/pacman/pkg}"

if [[ ! -r "$CACHE" ]]; then
    log_err "cache pacman absent ($CACHE) : rien à restaurer"
    exit 1
fi

# Dernière transaction ALPM dans le journal
start="$(grep -n '\[ALPM\] transaction started' "$PACMAN_LOG" 2>/dev/null | tail -1 | cut -d: -f1 || true)"
if [[ -z "${start:-}" ]]; then
    log_err "aucune transaction ALPM dans $PACMAN_LOG : rien à restaurer"
    exit 1
fi
log "dernière transaction pacman : ligne $start"

# "upgraded <nom> (<ancienne> -> <nouvelle>)" → on récupère nom + ancienne version
mapfile -t candidates < <(
    tail -n "+$start" "$PACMAN_LOG" \
        | sed -nE 's/.*\[ALPM\] upgraded ([^ ]+) \(([^ ]+) -> [^)]+\).*/\1 \2/p' \
        | sort -u \
        | while read -r name old; do
            # le fichier du cache : nom-version-anything.pkg.tar.zst
            ls "$CACHE/$name-$old"-*.pkg.tar.zst 2>/dev/null | head -n1
        done
)

if (( ${#candidates[@]} == 0 )); then
    log_err "aucun paquet de la dernière update n'est encore dans le cache"
    log "bob fixme ne peut PAS inventer un paquet absent (snapshots Btrfs :"
    log "ce serait le rôle de snapper + snap-pac, pas encore configurés)"
    exit 1
fi

echo
log "paquets qui peuvent être remis à leur version précédente :"
printf '  • %s\n' "${candidates[@]##*/}"
echo
read -rp "Restaurer ces versions ? [o/N] " ok
if [[ "${ok:-}" != [oO] ]]; then
    log "annulé"
    exit 0
fi

pacman -U "${candidates[@]}" && log "rollback effectué. Redémarre si un service te le demande." || {
    log_err "le rollback a échoué (paquets manquants ? conflit ?)"
    exit 1
}
