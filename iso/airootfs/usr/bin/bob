#!/usr/bin/env bash
# bob — wrapper pacman de BobOS
set -euo pipefail

BOBOS_LIB="${BOBOS_LIB:-/usr/local/lib/bobos/common.sh}"
# shellcheck source=/dev/null
[[ -r "$BOBOS_LIB" ]] && source "$BOBOS_LIB"

usage() {
    cat <<'EOF'
bob — wrapper pacman de BobOS

usage :
  bob -S <paquet>     installe un paquet (repo bob-core compris)
  bob -Syy            resynchronise les bases
  bob -Q              liste les paquets installés
  bob -Ss <mot>       cherche un paquet
  bob update          alias de bob-update
  bob fixme           rollback de la dernière mise à jour
  bob dotfiles apply  applique les dotfiles BobOS (avec sauvegarde)
EOF
}

cmd="${1:-}"

case "$cmd" in
    update)
        exec /usr/bin/bob-update "$@"
        ;;
    fixme)
        exec /usr/bin/bob-fixme "$@"
        ;;
    dotfiles)
        # /etc/skel est lisible par tout le monde : AUCUNE élévation ici.
        # L'ancien code s'élevait puis faisait `chown -R $(id -u)` alors que
        # id -u valait 0 → tout le $HOME appartenait à root (audit BOB-01).
        if [[ "${2:-}" != "apply" ]]; then
            echo "usage : bob dotfiles apply" >&2
            exit 1
        fi
        backup="$HOME/.local/state/bobos/dotfiles-$(date +%Y%m%d-%H%M%S)"
        mkdir -p "$backup"
        rsync -a --backup --backup-dir="$backup" /etc/skel/ "$HOME"/
        log "dotfiles appliqués dans $HOME"
        log "tes fichiers précédents sont dans : $backup"
        ;;
    -h|--help|help|"")
        usage
        ;;
    -Q|-Q*|-Ss|-Si|-Qi|-Qii|-Qq)
        # opérations de lecture : le root n'apporte rien
        exec pacman "$@"
        ;;
    -h*)
        usage
        ;;
    *)
        # opérations qui modifient le système : élévation
        require_root "$@"
        exec pacman "$@"
        ;;
esac
