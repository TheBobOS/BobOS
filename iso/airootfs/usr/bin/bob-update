#!/usr/bin/env bash
# bob-update — mise à jour complète de BobOS
set -euo pipefail

BOBOS_LIB="${BOBOS_LIB:-/usr/local/lib/bobos/common.sh}"
# shellcheck source=/dev/null
[[ -r "$BOBOS_LIB" ]] && source "$BOBOS_LIB"

require_root "$@"

echo "=============================="
echo "   bob-update — BobOS"
echo "=============================="

# 1. News Arch : les interventions manuelles cassent les mises à jour
echo "[bob-update] news Arch récentes :"
if news="$(curl -fsS --max-time 15 https://archlinux.org/feeds/news/ 2>/dev/null)"; then
    printf '%s' "$news" \
        | grep -oP '<title>\K[^<]+' \
        | tail -n +2 | head -4 | sed 's/^/  • /' || true
else
    echo "  (pas de réseau : news illisibles, la mise à jour échouera aussi)"
fi
echo

# « || true » INDISPENSABLE : en mode graphique (pkexec) stdin n'est pas un
# terminal, le read renvoie EOF… et avec « set -e » ça tuait le script juste
# après les news, sans rien installer.
read -rp "Continuer ? [O/n] " ok || true
[[ "${ok:-o}" == [nN] ]] && exit 0

# 2. Trousseau EN PREMIER : quand Arch change ses clés, une mise à jour
#    normale échoue (le nouveau paquet est signé avec une clé inconnue).
log "mise à jour du trousseau de clés…"
pacman -Sy --needed archlinux-keyring

# 3. La mise à jour elle-même. En mode graphique (bobos-update → pkexec) il n'y
#    a pas de terminal : sans --noconfirm, pacman n'a personne à interroger et
#    la transaction meurt en silence. Les erreurs restent, elles, remontées.
if [[ -t 0 ]]; then
    log "mise à jour du système…"
    if pacman -Su; then
        :
    else
        log_err "la mise à jour a échoué ou a été annulée"
        log "pour revenir en arrière : bob fixme"
        exit 1
    fi
else
    log "mise à jour du système (mode graphique, sans questions)…"
    if pacman -Su --noconfirm; then
        :
    else
        log_err "la mise à jour a échoué (conflit de fichier, paquet à supprimer ?)"
        log "relance dans un terminal pour répondre aux questions : bob-update"
        exit 1
    fi
fi

# 4. Fichiers de configuration remplacés (.pacnew) : on les montre
if command -v pacdiff &>/dev/null; then
    echo
    log "fichiers .pacnew en attente :"
    pacdiff -o | sed 's/^/  /' || true
fi

# 5. Cache : on garde 2 versions par paquet (bob fixme s'en sert)
if command -v paccache &>/dev/null; then
    paccache -rk2 &>/dev/null || true
fi

# 6. Marqueur pour bob fixme (la dernière transaction ALPM sert de référence).
# Non bloquant : si /var n'est pas inscriptible, la MAJ a réussi quand même.
if install -d -m 0755 /var/lib/bobos 2>/dev/null; then
    date -u +%FT%TZ > /var/lib/bobos/last-update 2>/dev/null || true
else
    log "marqueur /var/lib/bobos/last-update non écrit (permission ?)"
fi
log "update terminée. En cas de galère : bob fixme"
