#!/usr/bin/env bash
# bobos-screen — règle l'écran sur le meilleur mode possible (résolution +
# rafraîchissement) sans jamais laisser un écran noir irrécupérable.
#
# En VM (VirtualBox, QEMU…) on ne force PAS 1920x1080 : la VM expose ce que le
# pilote DRM voit, et un mode hors plage = écran noir. On prend donc le plus
# grand mode ≤ 1080p, et chaque application est vérifiée puis annulée si elle
# n'a pas été prise.
set -u

FLAG="$HOME/.config/bobos/screen-manual"

# choix manuel conservé (bobos-res) : on ne touche à rien
if [ -f "$FLAG" ]; then
    exit 0
fi

# width <renvoie la largeur active d'un écran>
width_of() {
    hyprctl monitors -j 2>/dev/null \
        | jq -r --arg n "$1" '.[] | select(.name==$n) | .width' 2>/dev/null | head -n1
}

# apply <écran> <mode> : applique, vérifie, revient en arrière si ça rate
apply() {
    local name="$1" mode="$2" want prev got
    want="${mode%%x*}"                 # ex. 1920x1080@60 → 1920
    prev="$(hyprctl monitors -j 2>/dev/null \
        | jq -r --arg n "$name" '.[] | select(.name==$n) | "\(.width)x\(.height)@\(.refreshRate)"' 2>/dev/null | head -n1)"

    hyprctl keyword monitor "$name,$mode,auto,1" >/dev/null 2>&1 || return 1
    sleep 1

    got="$(width_of "$name")"
    if [ -z "$got" ] || [ "$got" -lt "$want" ] 2>/dev/null; then
        if [ -n "$prev" ]; then
            hyprctl keyword monitor "$name,$prev,auto,1" >/dev/null 2>&1 || true
        fi
        command -v notify-send >/dev/null 2>&1 && \
            notify-send -u critical "BobOS" "Mode $mode refusé par l'écran — retour au mode précédent." || true
        return 1
    fi
    return 0
}

# best_for <json du moniteur> : le plus grand mode ≤ 1080p, puis le plus haut
# rafraîchissement. On ne force JAMAIS un mode que le pilote n'annonce pas :
# hors plage = écran noir sans retour (c'était le bug de l'ancienne version,
# qui forçait 1920x1080 dans toutes les VM).
best_mode() {
    local mon_json="$1" cap="$2"
    printf '%s' "$mon_json" | jq -r --argjson cap "$cap" '
        [.availableModes[]?
         | capture("(?<w>[0-9]+)x(?<h>[0-9]+)@(?<hz>[0-9.]+)Hz")
         | {w: (.w|tonumber), h: (.h|tonumber), hz: (.hz|tonumber),
            mode: (.w + "x" + .h + "@" + .hz)}]
        | map(select((.w * .h) <= ($cap.w * $cap.h)))
        | sort_by(.w, .h, .hz) | last
        | if . == null then "" else .mode end'
}

# attendre que Hyprland expose les outputs
mons=""
for _ in $(seq 1 15); do
    mons="$(hyprctl monitors -j 2>/dev/null)" && break
    sleep 1
done
[ -n "$mons" ] || exit 0

# plafond 1080p : au-delà, une fenêtre de VM devient illisible
CAP="{\"w\":1920,\"h\":1080}"

echo "$mons" | jq -c '.[]' | while read -r mon; do
    name="$(echo "$mon" | jq -r '.name')"
    best="$(best_mode "$mon" "$CAP")"
    [ -n "$best" ] || continue

    if apply "$name" "$best"; then
        :
    else
        # plan B : on essaie les résolutions classiques, une par une
        for cand in 1920x1080@60 1600x900@60 1366x768@60; do
            if apply "$name" "$cand"; then
                break
            fi
        done
    fi
done
exit 0
