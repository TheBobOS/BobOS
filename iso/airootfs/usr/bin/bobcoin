#!/usr/bin/env bash
# bobcoin — ledger intergalactique BobOS
# Solde injecté dans le prompt zsh via `bobcoin --prompt`.
#
# L'état est PAR UTILISATEUR (~/.local/state/bobos/bobcoin) : pas de fichier
# world-writable dans /var/lib, donc plus d'élévation de privilèges possible
# via ce ledger (audit SEC-03 / BOB-06).
set -euo pipefail

BOBOS_LIB="${BOBOS_LIB:-/usr/local/lib/bobos/common.sh}"
# shellcheck source=/dev/null
[[ -r "$BOBOS_LIB" ]] && source "$BOBOS_LIB" || {
    log_err "bibliothèque BobOS introuvable : $BOBOS_LIB"
    exit 1
}

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/bobcoin"
LEDGER="$STATE_DIR/balance"
MINE_FILE="$STATE_DIR/last-mine"

balance() { read_int "$LEDGER" 0; }

set_balance() {  # set_balance <entier ≥ 0>
    local v="${1:-}"
    [[ "$v" =~ ^[0-9]{1,18}$ ]] || { log_err "solde invalide : $v"; return 1; }
    mkdir -p "$STATE_DIR"
    printf '%s\n' "$v" > "$LEDGER"
}

case "${1:-}" in
    --prompt|-p)
        # lecture seule : aucun doas, aucune création, aucun chmod (le prompt
        # zsh appelle ça à chaque ligne de commande)
        printf '◈ %s BC\n' "$(balance)"
        ;;
    mine|m)
        new=$(( $(balance) + 10 ))
        set_balance "$new"
        # horodatage RÉEL (l'ancien code faisait `touch`, donc le contenu
        # restait vide et le killer fermait tout : audit BOB-02)
        date +%s > "$MINE_FILE"
        log "tu as miné 10 BC. Solde : $new"
        ;;
    send|s)
        if [[ $# -lt 3 ]]; then
            echo "usage : bobcoin send <dest> <montant>" >&2
            exit 1
        fi
        dest="$2"; amount="$3"
        # montant strictement positif et strictement numérique (sinon
        # `send x -500` augmentait le solde)
        if [[ ! "$amount" =~ ^[0-9]{1,18}$ ]] || (( amount == 0 )); then
            log_err "montant invalide (entier > 0 attendu) : $amount"
            exit 1
        fi
        bal="$(balance)"
        if (( amount > bal )); then
            log_err "solde insuffisant ($bal BC)"
            exit 1
        fi
        set_balance $(( bal - amount ))
        log "envoyé $amount BC à $dest. Solde : $(( bal - amount ))"
        ;;
    balance|b|"")
        printf '%s BC\n' "$(balance)"
        ;;
    last-mine)
        read_int "$MINE_FILE" 0
        ;;
    *)
        echo "usage : bobcoin [--prompt|mine|send <dest> <montant>|balance|last-mine]" >&2
        exit 1
        ;;
esac
