#!/usr/bin/env bash
# bob-slot-machine — machine à sous martienne (jackpot bobcoin)
set -euo pipefail

BOBOS_LIB="${BOBOS_LIB:-/usr/local/lib/bobos/common.sh}"
# shellcheck source=/dev/null
[[ -r "$BOBOS_LIB" ]] && source "$BOBOS_LIB" || {
    log_err "bibliothèque BobOS introuvable : $BOBOS_LIB"
    exit 1
}

LEDGER="${XDG_STATE_HOME:-$HOME/.local/state}/bobcoin/balance"
bal="$(read_int "$LEDGER" 0)"

sym=("🪐" "👾" "👽" "🛸" "☄️" "KEKW")
cost=10

# Chaque symbole occupe 8 colonnes à l'écran : un emoji fait 2 colonnes de
# large, « KEKW » fait 4 → on remplit à la main, pas de calcul d'octets.
pad8() {
    case "$1" in
        "KEKW") printf '  KEKW  ' ;;
        *)      printf '  %s    ' "$1" ;;
    esac
}

# cadre ASCII : l'alignement est exact (1 octet = 1 colonne)
printf '╔%s╗\n' "$(printf '═%.0s' {1..44})"
printf '║ %-42s ║\n' "MACHINE A SOUS MARTIENNE"
printf '╠%s╣\n' "$(printf '═%.0s' {1..44})"
printf '║ %-42s ║\n' "Solde : $bal BC"
printf '╚%s╝\n' "$(printf '═%.0s' {1..44})"
echo

if (( bal < cost )); then
    log_err "solde insuffisant pour jouer (min $cost BC). Mine avec : bobcoin mine"
    exit 1
fi

bal=$(( bal - cost ))

# animation de roulement
printf '  Roulement '
for _ in 1 2 3; do
    printf '\r  [%s%s%s]' "$(pad8 "${sym[$((RANDOM % 6))]}")" "$(pad8 "${sym[$((RANDOM % 6))]}")" "$(pad8 "${sym[$((RANDOM % 6))]}")"
    sleep 0.12
done
echo

a="${sym[$((RANDOM % 6))]}"
b="${sym[$((RANDOM % 6))]}"
c="${sym[$((RANDOM % 6))]}"

printf '  ┌%s┬%s┬%s┐\n' "$(printf '─%.0s' {1..8})" "$(printf '─%.0s' {1..8})" "$(printf '─%.0s' {1..8})"
printf '  │%s│%s│%s│\n' "$(pad8 "$a")" "$(pad8 "$b")" "$(pad8 "$c")"
printf '  └%s┴%s┴%s┘\n' "$(printf '─%.0s' {1..8})" "$(printf '─%.0s' {1..8})" "$(printf '─%.0s' {1..8})"
echo

if [[ "$a" == "$b" && "$b" == "$c" ]]; then
    if [[ "$a" == "KEKW" ]]; then
        prize=500
        log "JACKPOT KEKW !!! +$prize BC"
    else
        prize=100
        log "TROIS MARTIENS !!! +$prize BC"
    fi
    bal=$(( bal + prize ))
elif [[ "$a" == "$b" || "$b" == "$c" || "$a" == "$c" ]]; then
    prize=20
    log "une paire ! +$prize BC"
    bal=$(( bal + prize ))
else
    log "perdu… (-$cost BC)"
fi

mkdir -p "$(dirname "$LEDGER")"
printf '%s\n' "$bal" > "$LEDGER"
echo
log "nouveau solde : $bal BC — rejouer : bob-slot-machine"
