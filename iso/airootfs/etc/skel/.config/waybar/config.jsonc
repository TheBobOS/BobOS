// BobOS — waybar
{
    "layer": "top",
    "position": "top",
    "height": 30,

    "modules-left": ["custom/menu", "custom/settings", "custom/firefox", "custom/files", "custom/terminal"],
    "modules-center": ["clock"],
    "modules-right": ["pulseaudio", "backlight", "bluetooth", "network", "cpu", "memory", "battery", "tray", "custom/power"],

    "custom/menu": {
        "format": "☰ Applications",
        "tooltip": false,
        "on-click": "wofi --show drun"
    },

    "custom/settings": {
        "format": " ",
        "tooltip": false,
        "on-click": "bobos-settings"
    },

    "custom/firefox": {
        "format": " ",
        "tooltip": false,
        "on-click": "firefox"
    },

    "custom/files": {
        "format": " ",
        "tooltip": false,
        "on-click": "thunar"
    },

    "custom/terminal": {
        "format": " ",
        "tooltip": false,
        "on-click": "kitty"
    },

    "custom/power": {
        "format": " ",
        "tooltip": false,
        "on-click": "bobos-power"
    },

    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "<tt>{:%d %B %Y — %A}</tt>"
    },

    "cpu": {
        "interval": 2,
        "format": "cpu {usage}%"
    },

    "memory": {
        "interval": 2,
        "format": "ram {percentage}%"
    },

    "network": {
        "interval": 2,
        "format-wifi": "WiFi {essid} ({signalStrength}%)",
        "format-ethernet": "Éthernet {ifname}",
        "format-disconnected": "Pas de réseau",
        "tooltip-format": "{ifname} : {ipaddr}/{cidr}",
        "tooltip-format-wifi": "{essid} — {ipaddr}/{cidr} ({ifname})"
    },

    "battery": {
        "interval": 30,
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}%",
        "format-plugged": "{capacity}% (AC)"
    },

    "pulseaudio": {
        "format": "vol {volume}%",
        "format-muted": "vol sourd",
        "format-icons": {
            "default": "",
            "overload": ""
        },
        "on-click": "pavucontrol"
    },

    "backlight": {
        "format": "lum {percent}%",
        "format-icons": ["", ""]
    },

    "bluetooth": {
        "format": "bt {status}",
        "format-connected": "bt {device_alias}",
        "format-disconnected": "bt off",
        "tooltip-format": "{device_enumerate}",
        "on-click": "blueman-manager"
    },

    "tray": {
        "spacing": 8
    }
}
